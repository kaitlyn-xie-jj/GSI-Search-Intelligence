@@ -173,6 +173,7 @@ private:
 	matrix::Vector3f _euler_prev{};
 	hrt_abstime _timestamp_prev{};
+	hrt_abstime _last_imu_timestamp{};
 
 	const std::string _world_name;
 	const std::string _model_name;
