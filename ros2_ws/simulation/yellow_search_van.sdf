<?xml version="1.0"?>
<sdf version="1.9">
  <!-- Visual asset: OpenRobotics / Nate Koenig SUV, CC BY 3.0. -->
  <model name="yellow_search_van">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>
    <link name="body">
      <collision name="body_collision">
        <pose>0 0 0.85 0 0 0</pose>
        <geometry>
          <!-- A simple collision box is faster and more stable than mesh collision. -->
          <box><size>4.7 1.9 1.7</size></box>
        </geometry>
      </collision>
      <visual name="suv_body">
        <pose>0 0 0 0 0 -1.57079632679</pose>
        <geometry>
          <mesh>
            <scale>0.06 0.06 0.06</scale>
            <uri>models/yellow_search_van/meshes/suv.obj</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
